{
  "name": "angnative-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance Angular Native cross-platform application framework powered by Rust",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm run build:packages",
    "build:packages": "pnpm -r --filter \"!@angnative/native-ui-core\" build",
    "test": "vitest run",
    "lint": "pnpm --recursive run lint",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:rust-size": "node scripts/check-rust-size.mjs",
    "check:web-size": "node scripts/check-web-size-budget.mjs",
    "compile:fixtures": "node scripts/compile-fixtures.mjs",
    "compile:aot": "node scripts/compile-aot.mjs",
    "compile:aot:router": "node scripts/compile-aot.mjs tsconfig.aot.router.json",
    "compile:aot:forms": "node scripts/compile-aot.mjs tsconfig.aot.forms.json",
    "compile:aot:i18n": "node scripts/compile-aot.mjs tsconfig.aot.i18n.json",
    "compile:aot:animations": "node scripts/compile-aot.mjs tsconfig.aot.animations.json",
    "compile:aot:marketpulse": "node scripts/compile-aot.mjs tsconfig.aot.marketpulse.json",
    "compile:aot:web": "node scripts/compile-aot.mjs tsconfig.aot.web.json",
    "compile:aot:web-fixture": "node scripts/compile-aot.mjs tsconfig.aot.web-fixture.json",
    "bundle:aot:web": "node scripts/bundle-web-aot.mjs",
    "bundle:quickjs": "node scripts/bundle-quickjs.mjs",
    "bundle:marketpulse": "node scripts/bundle-marketpulse.mjs",
    "bundle:forms": "node scripts/bundle-forms.mjs",
    "bundle:framework": "node scripts/bundle-framework.mjs",
    "bundle:third-party": "node scripts/bundle-third-party.mjs",
    "bundle:bytecode": "cargo run -p angnative-host-engine --bin dump-bytecode -- dist/aot/animations-app-bundle.js dist/aot/animations-app-bundle.qjsbc",
    "bundle:fixtures": "node -e \"import('./packages/cli/dist/bundle.js').then(m => m.bundleApp('packages/testing/fixtures/out/app.js', 'packages/testing/fixtures/out/bundle.js'))\"",
    "start": "pnpm --filter @angnative/web run build && pnpm compile:aot:web && pnpm bundle:aot:web && node scripts/serve-web.mjs"
  },
  "keywords": [
    "angular",
    "native",
    "rust",
    "cross-platform",
    "android",
    "desktop",
    "web"
  ],
  "author": "AngNative Team",
  "license": "MIT",
  "devDependencies": {
    "@angnative/common": "0.1.0",
    "@angnative/platform": "0.1.0",
    "@angnative/web": "0.1.0",
    "@angular/animations": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-browser-dynamic": "22.3.0",
    "@angular/router": "22.3.0",
    "@types/node": "26.6.11",
    "esbuild": "0.28.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "5.1.2"
  }
}
