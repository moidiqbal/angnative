{
  "name": "@angnative/contract",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "AngNative element contracts, CSS-subset style table, and the versioned TS↔Rust command protocol",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "default": "./dist/elements.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "default": "./dist/style.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": ["dist/**"],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "3.2.4"
  }
}
