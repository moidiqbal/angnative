{
  "name": "view-flattening",
  "description": "A component host with no style/prop/listener gets no native view (view flattening). The Custom host node is retained in the shadow tree even when flattened at paint time.",
  "commands": [
    { "kind": "CreateNode", "id": 1, "nodeType": "View" },
    { "kind": "CreateNode", "id": 2, "nodeType": "Custom" },
    { "kind": "CreateNode", "id": 3, "nodeType": "View" },
    { "kind": "InsertChild", "parentId": 1, "childId": 2, "index": 0 },
    { "kind": "InsertChild", "parentId": 2, "childId": 3, "index": 0 }
  ],
  "expect": {
    "nodes": {
      "1": { "children": [2] },
      "2": { "children": [3] },
      "3": { "children": [] }
    }
  }
}
