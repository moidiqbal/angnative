{
  "name": "view-flattening",
  "description": "A component host with no style/prop/listener gets no native view (view flattening).",
  "commands": [
    { "kind": "CreateNode", "id": 1, "nodeType": "View" },
    { "kind": "CreateNode", "id": 2, "nodeType": "Custom" },
    { "kind": "CreateNode", "id": 3, "nodeType": "View" },
    { "kind": "InsertChild", "parentId": 1, "childId": 2, "index": 0 },
    { "kind": "InsertChild", "parentId": 2, "childId": 3, "index": 0 }
  ],
  "expect": {
    "node1": { "children": [2] },
    "node2": { "children": [3], "note": "Custom host node retained in tree even if flattened at paint" },
    "node3": { "children": [] }
  }
}
