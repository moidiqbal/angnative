{
  "name": "multiple-listeners-per-event",
  "description": "Multiple listeners can be registered for the same event on one node; both listener properties are retained verbatim.",
  "commands": [
    { "kind": "CreateNode", "id": 1, "nodeType": "View" },
    { "kind": "SetProperty", "id": 1, "key": "listener:press:1", "value": { "eventName": "press", "callback": "fn1" } },
    { "kind": "SetProperty", "id": 1, "key": "listener:press:2", "value": { "eventName": "press", "callback": "fn2" } }
  ],
  "expect": {
    "nodes": {
      "1": {
        "properties": {
          "listener:press:1": { "eventName": "press", "callback": "fn1" },
          "listener:press:2": { "eventName": "press", "callback": "fn2" }
        }
      }
    }
  }
}
