{
  "name": "native-primitives-tagged-custom",
  "description": "Canonical na-list, na-switch and na-activity-indicator travel on the wire as tagged custom node types (Custom:na-*) so native shells materialize real views. An untagged Custom node stays a generic host node. Deterministic tree with a property and a style assertion.",
  "commands": [
    { "kind": "CreateNode", "id": 1, "nodeType": "View" },
    { "kind": "CreateNode", "id": 2, "nodeType": "Custom:na-list" },
    { "kind": "CreateNode", "id": 3, "nodeType": "Custom:na-switch" },
    { "kind": "CreateNode", "id": 4, "nodeType": "Custom:na-activity-indicator" },
    { "kind": "CreateNode", "id": 5, "nodeType": "Custom" },
    { "kind": "InsertChild", "parentId": 1, "childId": 2, "index": 0 },
    { "kind": "InsertChild", "parentId": 1, "childId": 3, "index": 1 },
    { "kind": "InsertChild", "parentId": 1, "childId": 4, "index": 2 },
    { "kind": "InsertChild", "parentId": 1, "childId": 5, "index": 3 },
    { "kind": "SetProperty", "id": 3, "key": "value", "value": true },
    { "kind": "SetStyle", "id": 4, "key": "opacity", "value": "0.75" }
  ],
  "expect": {
    "mutationKinds": [
      "CreateNode",
      "CreateNode",
      "CreateNode",
      "CreateNode",
      "CreateNode",
      "InsertChild",
      "InsertChild",
      "InsertChild",
      "InsertChild",
      "SetProperty",
      "SetStyle"
    ],
    "nodes": {
      "1": { "children": [2, 3, 4, 5] },
      "2": { "nodeType": "Custom:na-list", "parentId": 1 },
      "3": {
        "nodeType": "Custom:na-switch",
        "parentId": 1,
        "properties": { "value": true }
      },
      "4": {
        "nodeType": "Custom:na-activity-indicator",
        "parentId": 1,
        "styles": { "opacity": "0.75" }
      },
      "5": { "nodeType": "Custom", "parentId": 1 }
    }
  }
}
