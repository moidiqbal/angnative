# Rust
target/
**/*.rs.bk
# Cargo.lock is intentionally committed for reproducible builds.

# Generated native libraries — rebuild with scripts/build-android-native.ps1
# (or .sh). They are large and duplicated per ABI per project, so they are
# produced locally instead of being tracked.
**/jniLibs/**/*.a

# TypeScript incremental build cache
*.tsbuildinfo

# Node / Angular
node_modules/
dist/
.angular/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Android
.gradle/
build/
.cxx/
local.properties
*.aar
*.apk

# iOS
*.ipa
*.xcarchive
*.dSYM/
.swiftpm/
# Staged by scripts/build-ios-native.sh (do not commit native build outputs)
platforms/ios/Sources/AngNativeHost/*.a
platforms/ios/Sources/AngNativeHost/include/

# Generated test fixtures
packages/testing/fixtures/out/

# Local Research & Chat Logs
research/
post.txt
date 14nov2026_google.txt
*14nov*.txt
*nov2026*.txt

# IDE & OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
